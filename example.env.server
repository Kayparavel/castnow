# MYSQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DB=newsnow

# TTS
MIMO_API_KEY=
TTS_BASE_URL=https://api.xiaomimimo.com/v1

# 音色复刻参考音频文件路径（仅支持 wav/mp3）
TTS_VOICE_SAMPLE_PATH=./data/voice-sample.wav

# TTS 合成风格指令（通过 user message 控制语音风格，留空则不指定）
TTS_STYLE_PROMPT=

# 定时刷新间隔（秒），不设置或为0则不启用
CRON_INTERVAL=

# 后端缓存 TTL（秒），默认 300（5 分钟）
CACHE_TTL=300

# sources.json 路径
SOURCES_JSON_PATH=./data/sources.json

# 服务端口
PORT=3000
